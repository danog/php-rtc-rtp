{
    "name": "danog/php-rtc-rtp",
    "type": "library",
    "description": "RTP packet and media transport handling for PHP, ported to Amp v3. MadelineProto's PHP 8.2+ fork supports optional media FFI in the modular danog/php-rtc stack.",
    "keywords": [
        "webrtc",
        "rtp",
        "real-time-transport-protocol"
    ],
    "homepage": "https://github.com/danog/php-rtc-rtp",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3.1",
        "danog/php-rtc-exception": "^1.0",
        "danog/php-rtc-codecs": "^1.0",
        "danog/php-rtc-rtp-parameter": "^1.0",
        "danog/php-rtc-rtcp": "^1.0",
        "danog/php-rtc-stats": "^1.0",
        "danog/php-rtc-ntp": "^1.0",
        "danog/php-rtc-sdp": "^1.0",
        "ramsey/uuid": "^4.7",
        "amphp/pipeline": "1.x-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "symfony/phpunit-bridge": "7.3.x-dev",
        "dg/bypass-finals": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\RTP\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\RTP\\": "tests"
        }
    },
    "minimum-stability": "stable"
}
